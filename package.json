{
  "devDependencies": {
    "concurrently": "^9.1.2",
    "husky": "^9.1.7"
  },
  "name": "veldt",
  "version": "0.0.1",
  "main": "index.js",
  "repository": "git@github.com:chloebrett/veldt.git",
  "author": "Chloe Brett <chloebrett@users.noreply.github.com>",
  "license": "MIT",
  "scripts": {
    "b": "yarn hb; yarn mb; yarn sb; yarn stb; yarn xb",
    "f": "yarn hf; yarn mf; yarn sf; yarn stf; yarn xf",
    "fix": "cd hydric; cargo fix --target=wasm32-unknown-unknown; cd ../mesic; cargo fix; cd ../shared; cargo fix; cd ../state; cargo fix; cd ../xeric; cargo fix",
    "l": "yarn hl; yarn ml; yarn sl; yarn stl; yarn xl",
    "p": "./.husky/pre-commit",
    "r": "yarn concurrently 'yarn xr' 'yarn hr'",
    "t": "yarn mt; yarn st; yarn stt; yarn xt",
    "hb": "cd hydric; ./build.sh",
    "hf": "cd hydric; cargo fmt",
    "hr": "cd hydric; ./run.sh",
    "hl": "cd hydric; cargo clippy --target=wasm32-unknown-unknown -- -W clippy::all",
    "mb": "cd mesic; cargo build",
    "mf": "cd mesic; cargo fmt",
    "ml": "cd mesic; cargo clippy -- -W clippy::all",
    "mt": "cd mesic; cargo test",
    "sb": "cd shared; cargo build",
    "sf": "cd shared; cargo fmt",
    "sl": "cd shared; cargo clippy -- -W clippy::all",
    "st": "cd shared; cargo test",
    "stb": "cd state; cargo build",
    "stf": "cd state; cargo fmt",
    "stl": "cd state; cargo clippy -- -W clippy::all",
    "stt": "cd state; cargo test",
    "xb": "cd xeric; cargo build",
    "xf": "cd xeric; cargo fmt",
    "xr": "cd xeric; RUST_LOG=trace cargo run",
    "xl": "cd xeric; cargo clippy -- -W clippy::all",
    "xt": "cd xeric; cargo test"
  }
}
